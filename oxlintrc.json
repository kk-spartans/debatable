{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "import", "jsx-a11y"],
  "env": {
    "browser": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": "off",
    "no-unused-vars": "error",
    "react/jsx-key": "error",
    "react/no-unused-state": "error"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
