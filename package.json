{
  "name": "debatable",
  "version": "1.3.0",
  "description": "AI debate simulator - two LLM instances argue PRO and NEG on a topic",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/kk-spartans/debatable"
  },
  "bin": {
    "debatable": "dist/debatable"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "start": "bun --watch run src/index.tsx",
    "release": "semantic-release --extends ./devops/semantic-release.json",
    "check": "bun run devops/check.ts"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@opentui/core": "^0.4.1",
    "@opentui/react": "^0.4.1",
    "react": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@e18e/cli": "^0.7.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.17",
    "ai": "^6.0.205",
    "effect": "^4.0.0-beta.83",
    "knip": "^6.16.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "react-doctor": "^0.5.6",
    "semantic-release": "^25.0.5",
    "typescript": "^6.0.3"
  },
  "reactDoctor": {
    "ignore": {
      "rules": [
        "react-doctor/no-unknown-property",
        "react-doctor/control-has-associated-label",
        "react-doctor/async-parallel",
        "react-doctor/async-await-in-loop",
        "react-doctor/no-event-handler",
        "deslop/unused-dev-dependency",
        "react-doctor/prefer-useReducer"
      ]
    }
  }
}
